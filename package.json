    "tailwind-gradient-mask-image": "^1.2.0",
    "vue": "^3.5.13",
    "vue3-colorpicker": "^2.3.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
