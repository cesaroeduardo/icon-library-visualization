{
  "name": "flat-color",
  "package": {
    "name": "@starter/flat-color"
  },
  "description": "Flat shapes in 2 to 4 brand colors, no gradient, no outline. Feature lists, onboarding, docs.",
  "style": {
    "name": "flat-color",
    "grid": 24,
    "live": 20,
    "paint": "fill",
    "minBar": 1.8,
    "prefix": "flat",
    "tones": {
      "detail": {
        "fallback": "palette"
      },
      "body": {
        "fallback": "palette"
      },
      "accent": {
        "fallback": "palette"
      },
      "accent2": {
        "fallback": "palette"
      }
    },
    "palette": {
      "light": {
        "default": {
          "detail": "#2E3A8C",
          "body": "#AEB9FF",
          "accent": "#22C38E",
          "accent2": "#FFC23D"
        }
      },
      "dark": {
        "default": {
          "detail": "#C3CBFF",
          "body": "#3B4699",
          "accent": "#3DDBA5",
          "accent2": "#FFD166"
        }
      }
    },
    "primaryCheck": false,
    "sizes": [
      24,
      32,
      48
    ],
    "context": {
      "font": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "radius": 10,
      "brand": "#3D4FE0",
      "onBrand": "#FFFFFF",
      "surface": "#FFFFFF",
      "sidebar": "#F4F5F8",
      "text": "#1B1F27",
      "border": "#E3E6EC",
      "surfaceDark": "#12151C",
      "sidebarDark": "#181C25",
      "textDark": "#E6E8EE",
      "borderDark": "#2A303C"
    }
  },
