{
  "name": "outline",
  "package": {
    "name": "@starter/outline"
  },
  "description": "Uniform rounded line (1.5 to 2). Pairs with line sets; dense UI, toolbars.",
  "style": {
    "name": "outline",
    "grid": 24,
    "live": 20,
    "paint": "stroke",
    "prefix": "ic",
    "stroke": {
      "width": 1.75,
      "linecap": "round",
      "linejoin": "round"
    },
    "radius": {
      "outer": 2.5,
      "inner": 1
    },
    "tones": {
      "line": {
        "fallbackOpacity": 1
      }
    },
    "palette": {
      "light": {
        "default": {
          "line": "#5E6676"
        },
        "hover": {
          "line": "#2F3542"
        },
        "active": {
          "line": "#8A4FDB"
        },
        "disabled": {
          "line": "#B4BAC6"
        }
      },
      "dark": {
        "default": {
          "line": "#A7AFBE"
        },
        "hover": {
          "line": "#E2E5EB"
        },
        "active": {
          "line": "#B3BEFF"
        },
        "disabled": {
          "line": "#5A6273"
        }
      }
    },
    "sizes": [
      16,
      20,
      24
    ],
    "darkMode": "class",
    "context": {
      "font": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "radius": 10,
      "brand": "#8A4FDB",
      "onBrand": "#FFFFFF",
      "surface": "#FFFFFF",
      "sidebar": "#F4F5F8",
      "text": "#1B1F27",
      "border": "#E3E6EC",
      "surfaceDark": "#12151C",
      "sidebarDark": "#181C25",
      "textDark": "#E6E8EE",
      "borderDark": "#2A303C"
    }
  },
