{
  "name": "pixel",
  "package": {
    "name": "@starter/pixel"
  },
  "description": "8-bit pixel art on a 16 or 24 cell grid, integer squares only, crisp edges. Games, playful brands, retro.",
  "style": {
    "name": "pixel",
    "grid": 16,
    "live": 14,
    "paint": "fill",
    "rendering": "crispEdges",
    "prefix": "px",
    "tones": {
      "ink": {
        "fallbackOpacity": 1
      },
      "fill": {
        "fallbackOpacity": 0.35
      }
    },
    "palette": {
      "light": {
        "default": {
          "ink": "#2F3542",
          "fill": "#C9CED8"
        },
        "hover": {
          "ink": "#1B1F27",
          "fill": "#C9CED8"
        },
        "active": {
          "ink": "#8A4FDB",
          "fill": "#D4B8FF"
        },
        "disabled": {
          "ink": "#B4BAC6",
          "fill": "#E3E6EC"
        }
      },
      "dark": {
        "default": {
          "ink": "#C9CED8",
          "fill": "#3A4252"
        },
        "hover": {
          "ink": "#FFFFFF",
          "fill": "#3A4252"
        },
        "active": {
          "ink": "#B3BEFF",
          "fill": "#34407F"
        },
        "disabled": {
          "ink": "#5A6273",
          "fill": "#2A303C"
        }
      }
    },
    "sizes": [
      16,
      32,
      48
    ],
    "context": {
      "font": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "radius": 10,
      "brand": "#8A4FDB",
      "onBrand": "#FFFFFF",
