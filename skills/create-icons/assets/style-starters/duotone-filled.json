{
  "name": "duotone-filled",
  "package": {
    "name": "@starter/duotone-filled"
  },
  "description": "Filled, two tones of one hue, no outline. Inactive gray, active brand. Panels and app UI.",
  "style": {
    "name": "duotone-filled",
    "grid": 24,
    "live": 20,
    "paint": "fill",
    "minBar": 1.8,
    "prefix": "ic",
    "radius": {
      "outer": 3.2,
      "inner": 1.2
    },
    "tones": {
      "detail": {
        "fallbackOpacity": 1,
        "role": "identifies the icon; must read alone at 16 px"
      },
      "body": {
        "fallbackOpacity": 0.4,
        "role": "the mass of the object"
      }
    },
    "palette": {
      "light": {
        "default": {
          "detail": "#7C8597",
          "body": "#C9CED8"
        },
        "hover": {
          "detail": "#5F6878",
          "body": "#B5BCC9"
        },
        "active": {
          "detail": "#8A4FDB",
          "body": "#D4B8FF"
        },
        "disabled": {
          "detail": "#B4BAC6",
          "body": "#E3E6EC"
        }
      },
      "dark": {
        "default": {
          "detail": "#9AA3B5",
          "body": "#3A4252"
        },
        "hover": {
          "detail": "#B8C0CF",
          "body": "#4A5366"
        },
        "active": {
          "detail": "#B3BEFF",
          "body": "#34407F"
        },
        "disabled": {
          "detail": "#5A6273",
          "body": "#2A303C"
        }
      }
    },
    "illustration": {
      "sizes": [
        48,
        96
      ],
      "tones": {
        "body": [
          "#EEF0FF",
          "#C9D0FF"
        ],
        "detail": [
          "#6A79F2",
          "#8A4FDB"
        ],
        "accent": [
          "#7BEFC4",
          "#1FC88A"
        ],
        "accent2": [
          "#FFE48A",
          "#FFBE3D"
        ]
      }
    },
    "sizes": [
      16,
      20,
      24
    ],
    "darkMode": "class",
    "darkSelector": [
      ".dark",
      "[data-theme=\"dark\"]"
    ],
    "context": {
      "font": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "radius": 10,
      "brand": "#8A4FDB",
      "onBrand": "#FFFFFF",
      "surface": "#FFFFFF",
      "sidebar": "#F4F5F8",
      "text": "#1B1F27",
      "border": "#E3E6EC",
      "surfaceDark": "#12151C",
      "sidebarDark": "#181C25",
      "textDark": "#E6E8EE",
      "borderDark": "#2A303C"
    }
  },
  "icons": [
    {
      "name": "home",
      "label": "Home",
      "group": "navigation",
      "tags": [
        "house",
        "start",
        "dashboard"
      ],
      "shapes": [
        {
          "tone": "body",
          "type": "path",
          "d": "M4 10h16v9a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3z"
        },
        {
          "tone": "detail",
          "type": "path",
          "d": "M10.7 2.5a2 2 0 0 1 2.6 0l8 6.6c.7.6.3 1.9-.65 1.9H3.35c-.95 0-1.35-1.3-.65-1.9z"
        },
        {
          "tone": "detail",
          "type": "path",
          "d": "M10 22v-4a2 2 0 0 1 4 0v4z",
          "illo": "accent"
        }
      ]
    },
    {
      "name": "bell",
      "label": "Notifications",
      "group": "navigation",
      "tags": [
        "bell",
        "alert",
        "reminder"
      ],
      "shapes": [
        {
          "tone": "body",
          "type": "path",
          "d": "M5.5 14h13l1.6 2.4A1.5 1.5 0 0 1 18.8 19H5.2a1.5 1.5 0 0 1-1.3-2.6L5.5 14z"
        },
        {
          "tone": "detail",
          "type": "path",
          "d": "M12 3a6.5 6.5 0 0 1 6.5 6.5V14H5.5V9.5A6.5 6.5 0 0 1 12 3z"
        },
        {
          "tone": "detail",
          "type": "path",
          "d": "M9.4 19.5h5.2a2.6 2.6 0 0 1-5.2 0z",
          "illo": "accent2"
        }
      ]
    },
    {
      "name": "chart",
      "label": "Reports",
      "group": "data",
      "tags": [
        "analytics",
        "bars",
        "stats"
      ],
      "shapes": [
        {
          "tone": "body",
          "type": "rect",
          "x": 2.5,
          "y": 2.5,
          "width": 19,
          "height": 19,
          "rx": 4
        },
        {
          "tone": "detail",
          "type": "rect",
          "x": 6.5,
          "y": 12,
          "width": 2.6,
          "height": 6,
          "rx": 1.3
        },
        {
          "tone": "detail",
          "type": "rect",
          "x": 10.7,
          "y": 8.5,
          "width": 2.6,
          "height": 9.5,
          "rx": 1.3
        },
        {
          "tone": "detail",
          "type": "rect",
          "x": 14.9,
          "y": 6,
          "width": 2.6,
          "height": 12,
          "rx": 1.3,
          "illo": "accent"
        }
      ]
    },
    {
      "name": "check",
      "label": "Done",
      "group": "status",
      "tags": [
        "success",
        "complete",
        "ok"
      ],
      "shapes": [
        {
          "tone": "body",
          "type": "circle",
          "cx": 12,
          "cy": 12,
          "r": 10
        },
        {
          "tone": "detail",
          "type": "path",
          "d": "M7.8 12.3l2.8 2.8 5.6-5.6",
          "bar": 2.6,
          "illo": "accent"
        }
      ]
    }
  ]
}
