{
  "name": "hand-drawn",
  "package": {
    "name": "@starter/hand-drawn"
  },
  "description": "Irregular, sketchy line with small overshoots and an optional loose fill. Editorial, notes, friendly onboarding.",
  "style": {
    "name": "hand-drawn",
    "grid": 24,
    "live": 20,
    "paint": "stroke",
    "prefix": "hd",
    "stroke": {
      "width": 1.6,
      "linecap": "round",
      "linejoin": "round"
    },
    "tones": {
      "ink": {
        "fallbackOpacity": 1
      },
      "wash": {
        "fallbackOpacity": 0.25
      }
    },
    "palette": {
      "light": {
        "default": {
          "ink": "#2F3542",
          "wash": "#DDE1E8"
        },
        "hover": {
          "ink": "#1B1F27",
          "wash": "#DDE1E8"
        },
        "active": {
          "ink": "#3D4FE0",
          "wash": "#D5DBFF"
        },
        "disabled": {
          "ink": "#B4BAC6",
          "wash": "#EEF0F3"
        }
      },
      "dark": {
        "default": {
          "ink": "#D3D7DF",
          "wash": "#353C4B"
        },
        "hover": {
          "ink": "#FFFFFF",
          "wash": "#353C4B"
        },
        "active": {
          "ink": "#B3BEFF",
          "wash": "#2E3770"
        },
        "disabled": {
          "ink": "#5A6273",
          "wash": "#262B36"
        }
      }
    },
    "sizes": [
      20,
      24,
      32
    ],
    "context": {
      "font": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "radius": 10,
      "brand": "#3D4FE0",
      "onBrand": "#FFFFFF",
      "surface": "#FFFFFF",
      "sidebar": "#F4F5F8",
      "text": "#1B1F27",
      "border": "#E3E6EC",
      "surfaceDark": "#12151C",
      "sidebarDark": "#181C25",
      "textDark": "#E6E8EE",
      "borderDark": "#2A303C"
    }
  },
